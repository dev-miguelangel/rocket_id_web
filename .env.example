# Copia este archivo a .env.local y completa con la config web de Firebase
# (Firebase Console > Configuración del proyecto > Tus apps > Web)
VITE_FIREBASE_API_KEY=
# En producción usa tu dominio de Vercel (ej: rocketid.vercel.app) para que el
# login por redirect funcione en Safari/iOS. En local usa <proyecto>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
