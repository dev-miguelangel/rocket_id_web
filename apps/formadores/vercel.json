{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:formadores",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../../shared ../../package.json ../../package-lock.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://rocketid-c55d5.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://rocketid-c55d5.firebaseapp.com/__/firebase/:path*"
    },
    { "source": "/((?!__/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
