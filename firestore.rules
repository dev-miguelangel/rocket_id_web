rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administración: solo la cuenta cuyo correo verificado tiene este hash sha256 (el correo no queda en texto)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == '4505f00c6a3f199d9f1a7b6a32b492291441f41fd8510826e44a76c0c306c6e4';
    }

    // Datos de prueba (mock): uid con prefijo mock_ y marca _mock. Solo la administración los crea o borra.
    function isMockUid(uid) {
      return uid is string && uid.matches('^mock_[a-z0-9_]{1,40}$');
    }
    function hasMockMark() {
      return request.resource.data._mock is map && request.resource.data._mock.isMock == true;
    }
    function adminMockWrite(uid) {
      return isAdmin() && isMockUid(uid) && hasMockMark();
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Campo opcional: si viene, debe ser string con largo máximo
    function optStr(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function rocketIdPath(code) {
      return /databases/$(database)/documents/rocketIds/$(code);
    }

    // rocketId en el perfil: una vez asignado no cambia; para asignarlo, su reserva
    // en rocketIds/{código} debe quedar a nombre de la persona en el mismo lote.
    function rocketIdOk(uid) {
      let had = resource != null && ('rocketId' in resource.data);
      let next = request.resource.data.get('rocketId', null);
      return had
        ? next == resource.data.rocketId
        : (next == null
            || (next is string
                && next.matches('^[BCDFGHJKLMNPQRSTVWXYZ][AEIOU]-[0-9]{4}$')
                && existsAfter(rocketIdPath(next))
                && getAfter(rocketIdPath(next)).data.uid == uid));
    }

    // Perfil e identificación: users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Métricas del panel admin (conteos agregados)
      allow list: if isAdmin();
      // Panel admin: crear y purgar usuarios de prueba
      allow create: if adminMockWrite(uid);
      allow delete: if isAdmin() && isMockUid(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt', 'updatedAt',
          'fullName', 'docType', 'docNumber', 'birthDate', 'phone', 'contactEmail',
          'rocketId', 'discoverable', 'exactOnly', 'onboardedAt',
          'bio' // legado del primer MVP
        ])
        && rocketIdOk(uid)
        && optStr(request.resource.data, 'fullName', 120)
        && optStr(request.resource.data, 'docType', 20)
        && optStr(request.resource.data, 'docNumber', 30)
        // Si es RUT, debe venir formateado: 12.345.678-5 / 7.775.735-K
        && (request.resource.data.get('docType', '') != 'rut'
            || request.resource.data.get('docNumber', '') == ''
            || request.resource.data.docNumber.matches('^[0-9]{1,2}[.][0-9]{3}[.][0-9]{3}-[0-9K]$'))
        && optStr(request.resource.data, 'birthDate', 10)
        && optStr(request.resource.data, 'phone', 20)
        && optStr(request.resource.data, 'contactEmail', 120)
        && (!('discoverable' in request.resource.data) || request.resource.data.discoverable is bool)
        && (!('exactOnly' in request.resource.data) || request.resource.data.exactOnly is bool)
        && (!('onboardedAt' in request.resource.data) || request.resource.data.onboardedAt is timestamp);
      allow delete: if false;

      // Notificaciones de la persona (no hay push: se ven en el menú del avatar).
      //  · Organizador → participante: invitación, evento editado, evento cancelado, ficha vista.
      //  · Participante → organizador: confirmó, se unió, no podrá ir.
      match /notifications/{nid} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['type', 'eventId', 'eventTitle', 'actorUid', 'actorName', 'detail', 'read', 'createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.eventTitle is string && request.resource.data.eventTitle.size() <= 100
          && request.resource.data.actorName is string && request.resource.data.actorName.size() <= 120
          && (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 160))
          && (
            // Organizador → participante
            (request.resource.data.type in ['event_invite', 'event_updated', 'event_cancelled', 'co_organizer_added']
              && get(eventPath(request.resource.data.eventId)).data.organizerUid == request.auth.uid
              && existsAfter(participantPath(request.resource.data.eventId, uid)))
            // Equipo de seguridad → participante: vio / guardó su ficha
            || (request.resource.data.type in ['sensitive_view', 'sensitive_saved']
              && isEventLead(request.resource.data.eventId)
              && existsAfter(participantPath(request.resource.data.eventId, uid)))
            // Participante → organizador
            || (request.resource.data.type in ['participant_confirmed', 'participant_joined', 'participant_declined']
              && get(eventPath(request.resource.data.eventId)).data.organizerUid == uid
              && existsAfter(participantPath(request.resource.data.eventId, request.auth.uid)))
            // Acceso de emergencia: aviso a la persona cuya ficha se abre…
            || (request.resource.data.type == 'emergency_access'
              && isConfirmedParticipant(request.resource.data.eventId)
              && inEmergencyWindow(request.resource.data.eventId)
              && exists(participantPath(request.resource.data.eventId, uid)))
            // Formador → persona que postuló: aceptó o rechazó su postulación (eventId = id del curso)
            || (request.resource.data.type in ['application_accepted', 'application_rejected']
              && existsAfter(applicationPath(uid + '_' + request.resource.data.eventId))
              && getAfter(applicationPath(uid + '_' + request.resource.data.eventId)).data.uid == uid
              && getAfter(applicationPath(uid + '_' + request.resource.data.eventId)).data.status
                == (request.resource.data.type == 'application_accepted' ? 'accepted' : 'rejected')
              && canDecideApplication(getAfter(applicationPath(uid + '_' + request.resource.data.eventId)).data)
              && request.resource.data.actorName
                == get(providerPath(getAfter(applicationPath(uid + '_' + request.resource.data.eventId)).data.providerId)).data.name)
            // Formador → persona invitada al equipo (eventId = id del formador)
            || (request.resource.data.type == 'provider_invite'
              && existsAfter(invitePath(request.resource.data.eventId, uid))
              && getAfter(invitePath(request.resource.data.eventId, uid)).data.invitedBy == request.auth.uid
              && request.resource.data.eventTitle == getAfter(invitePath(request.resource.data.eventId, uid)).data.providerName)
            // Formador → persona: verificó o rechazó una certificación (eventId = id de la certificación)
            || (request.resource.data.type in ['verification_approved', 'verification_rejected']
              && getAfter(verificationRequestPath(uid + '_' + request.resource.data.eventId)).data.uid == uid
              && getAfter(verificationRequestPath(uid + '_' + request.resource.data.eventId)).data.status
                == (request.resource.data.type == 'verification_approved' ? 'approved' : 'rejected')
              && canVerify(getAfter(verificationRequestPath(uid + '_' + request.resource.data.eventId)).data.providerId)
              && request.resource.data.actorName
                == getAfter(verificationRequestPath(uid + '_' + request.resource.data.eventId)).data.providerName)
            // …y alerta al organizador y al equipo de seguridad
            || (request.resource.data.type == 'emergency_alert'
              && isConfirmedParticipant(request.resource.data.eventId)
              && inEmergencyWindow(request.resource.data.eventId)
              && (get(eventPath(request.resource.data.eventId)).data.organizerUid == uid
                || uid in get(eventPath(request.resource.data.eventId)).data.get('coOrganizers', [])))
          );
      }

      // Mi cordada: lista privada de contactos. Solo se puede agregar a personas con perfil público.
      match /contacts/{cid} {
        allow read, delete: if isOwner(uid);
        // Panel admin: al purgar, quitar usuarios de prueba de las cordadas
        allow delete: if isAdmin() && isMockUid(cid);
        allow create, update: if isOwner(uid)
          && cid != uid
          && request.resource.data.keys().hasOnly(['uid', 'rocketId', 'displayName', 'photoURL', 'addedAt'])
          && request.resource.data.uid == cid
          && exists(/databases/$(database)/documents/publicProfiles/$(cid))
          && optStr(request.resource.data, 'displayName', 120)
          && optStr(request.resource.data, 'rocketId', 7);
      }

      // Conocimientos y certificaciones outdoor: users/{uid}/private/skills
      match /private/skills {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['hasCertifications', 'categories', 'certifications', 'updatedAt'])
          && request.resource.data.hasCertifications in ['yes', 'no', '']
          && request.resource.data.categories is list
          && request.resource.data.categories.size() <= 10
          && request.resource.data.certifications is list
          && request.resource.data.certifications.size() <= 20;
        allow delete: if false;
      }

      // Verificaciones de certificaciones hechas por instituciones.
      // La persona solo puede leerlas; nadie puede escribirlas desde el cliente.
      // TODO: permitir escritura a instituciones (custom claim) cuando exista su app.
      match /private/verifications {
        // Legible por cualquiera (también sin sesión, para el perfil público /p/{rocketId}):
        // las insignias se calculan con estas verificaciones, no con lo que declara cada persona.
        allow get: if true;
        // Solo el panel admin, y solo para usuarios de prueba (las reales las otorgan las instituciones)
        allow create: if adminMockWrite(uid);
        allow delete: if isAdmin() && isMockUid(uid);
        // Un formador verifica una certificación: solo esa entrada, copiando la solicitud aprobada en el mismo lote
        allow create, update: if providerVerifies(uid);
      }

      // Ficha de emergencia (datos sensibles de salud): users/{uid}/private/emergency
      match /private/{docId} {
        allow read: if isOwner(uid) && docId == 'emergency';
        allow create, update: if isOwner(uid) && docId == 'emergency'
          && request.resource.data.keys().hasOnly([
            'emergencyName', 'emergencyRelationship', 'emergencyPhone',
            'insuranceSystem', 'insuranceDetail', 'bloodType',
            'allergies', 'conditions', 'medications', 'updatedAt'
          ])
          && optStr(request.resource.data, 'emergencyName', 120)
          && optStr(request.resource.data, 'emergencyRelationship', 60)
          && optStr(request.resource.data, 'emergencyPhone', 20)
          && optStr(request.resource.data, 'insuranceSystem', 20)
          && optStr(request.resource.data, 'insuranceDetail', 500)
          && optStr(request.resource.data, 'bloodType', 10)
          && optStr(request.resource.data, 'allergies', 1000)
          && optStr(request.resource.data, 'conditions', 1000)
          && optStr(request.resource.data, 'medications', 1000);
        allow delete: if false;
      }
    }

    // Reserva de rocketIds: garantiza que cada código sea único.
    // Solo se puede crear (si ya existe, el set cuenta como update y se rechaza → colisión),
    // una vez por persona, y nunca modificar ni borrar.
    match /rocketIds/{code} {
      // get (no list): buscar a alguien por su rocketId exacto. Sin sesión, para el enlace público.
      allow get: if true;
      allow create: if request.auth != null
        && code.matches('^[BCDFGHJKLMNPQRSTVWXYZ][AEIOU]-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        // la persona aún no tenía rocketId…
        && !(exists(userPath(request.auth.uid)) && ('rocketId' in get(userPath(request.auth.uid)).data))
        // …y en el mismo lote lo escribe en su perfil
        && getAfter(userPath(request.auth.uid)).data.get('rocketId', '') == code;
      // Panel admin: rocketIds de usuarios de prueba
      allow create: if code.matches('^[BCDFGHJKLMNPQRSTVWXYZ][AEIOU]-[0-9]{4}$')
        && adminMockWrite(request.resource.data.uid);
      allow delete: if isAdmin() && (resource == null || isMockUid(resource.data.uid));
      allow update: if false;
    }

    // Perfil público: nombre, avatar, rocketId y conocimientos.
    // get: cualquiera con el uid, también sin sesión (búsqueda exacta o enlace compartido /p/{rocketId}).
    // list: solo perfiles con búsqueda aproximada activa (searchable) y de a 10 como máximo;
    // los perfiles "solo búsquedas exactas" nunca aparecen en un listado.
    match /publicProfiles/{uid} {
      allow get: if true;
      allow list: if request.auth != null
        && request.query.limit <= 10
        && resource.data.searchable == true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'rocketId', 'displayName', 'photoURL', 'skills', 'searchable', 'searchTokens', 'updatedAt'])
        && request.resource.data.get('searchable', false) is bool
        && request.resource.data.get('searchTokens', []) is list
        && request.resource.data.get('searchTokens', []).size() <= 100
        // sin búsqueda aproximada no se guardan tokens
        && (request.resource.data.get('searchable', false) == true || request.resource.data.get('searchTokens', []).size() == 0)
        && request.resource.data.uid == uid
        && request.resource.data.rocketId == get(userPath(uid)).data.get('rocketId', '')
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && request.resource.data.skills is map
        && request.resource.data.skills.categories is list && request.resource.data.skills.categories.size() <= 10
        && request.resource.data.skills.certifications is list && request.resource.data.skills.certifications.size() <= 20;
      allow delete: if isOwner(uid);
      // Panel admin: perfiles de usuarios de prueba
      allow create: if adminMockWrite(uid) && request.resource.data.uid == uid;
      allow delete: if isAdmin() && isMockUid(uid);
    }

    // Índice de búsqueda por correo: emailIndex/{sha256(correo en minúsculas)} → { uid }.
    // Contador de visitas de la landing: lectura pública; solo se puede sumar de a 1
    match /stats/landing {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
    }

    // Visitas por día (fecha en hora de Chile): mismas reglas de suma; solo administración las lista
    match /stats/landing/days/{day} {
      allow list: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
    }

    // El correo nunca se guarda en texto; solo encuentra a alguien quien conoce el correo exacto.
    // Solo puedes indexar TU correo verificado (el hash se recalcula aquí).
    match /emailIndex/{hash} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && hash == hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Panel admin: correos (ficticios) de usuarios de prueba
      allow create: if adminMockWrite(request.resource.data.uid);
      allow delete: if isAdmin() && (resource == null || isMockUid(resource.data.uid));
    }

    // Registro de datos de prueba (también lo usan los scripts de scripts/mock)
    match /_mock/registry {
      allow read, write: if isAdmin();
    }

    // Configuración visible para toda la app; solo la administración la cambia
    match /config/app {
      allow get: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['demoCourses', 'updatedAt'])
        && request.resource.data.demoCourses is bool;
    }

    // ---------- Eventos ----------
    function eventPath(eid) {
      return /databases/$(database)/documents/events/$(eid);
    }
    function participantPath(eid, uid) {
      return /databases/$(database)/documents/events/$(eid)/participants/$(uid);
    }
    function isEventOrganizer(eid) {
      return request.auth != null && get(eventPath(eid)).data.organizerUid == request.auth.uid;
    }
    function isEventParticipant(eid) {
      return request.auth != null && exists(participantPath(eid, request.auth.uid));
    }
    function isConfirmedParticipant(eid) {
      return request.auth != null
        && exists(participantPath(eid, request.auth.uid))
        && get(participantPath(eid, request.auth.uid)).data.status == 'confirmed';
    }
    // Equipo de seguridad: organizador, o co-organizador designado que sigue confirmado
    function isEventLead(eid) {
      return request.auth != null && (
        get(eventPath(eid)).data.organizerUid == request.auth.uid
        || (request.auth.uid in get(eventPath(eid)).data.get('coOrganizers', [])
            && isConfirmedParticipant(eid)));
    }
    // Acceso de emergencia: solo desde 2 h antes del inicio hasta 12 h después del término
    function inEmergencyWindow(eid) {
      return get(eventPath(eid)).data.status == 'published'
        && request.time >= get(eventPath(eid)).data.startAt - duration.value(2, 'h')
        && request.time <= get(eventPath(eid)).data.endAt + duration.value(12, 'h');
    }
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'activity', 'description', 'startAt', 'endAt', 'location', 'meetingPoint',
          'visibility', 'capacity', 'requirements', 'publicAck', 'status', 'organizerUid', 'organizerName',
          'organizerRocketId', 'organizerPhoto', 'coOrganizers', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.activity is string && d.activity.size() <= 20
        && d.description is string && d.description.size() <= 2000
        && d.location is string && d.location.size() <= 150
        && d.meetingPoint is string && d.meetingPoint.size() <= 200
        && d.startAt is timestamp && d.endAt is timestamp && d.endAt >= d.startAt
        && d.visibility in ['private', 'public']
        && d.capacity is int && d.capacity >= 0 && d.capacity <= 500
        && d.requirements is list && d.requirements.size() <= 10
        && d.status in ['published', 'cancelled']
        // Equipo de seguridad: hasta 2 co-organizadores
        && (!('coOrganizers' in d) || (d.coOrganizers is list && d.coOrganizers.size() <= 2 && !(d.organizerUid in d.coOrganizers)))
        // Público exige haber aceptado la alerta de responsabilidades
        && (d.visibility == 'private' || (d.publicAck is map && d.publicAck.version is string));
    }

    // Cualquier participante puede leer sus propias filas en todos los eventos (para "Mis eventos")
    match /{path=**}/participants/{pid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if isAdmin();
    }

    // Métricas del panel admin: total de vínculos de cordada
    match /{path=**}/contacts/{cid} {
      allow list: if isAdmin();
    }

    match /events/{eid} {
      // get: cualquiera con el enlace (id no adivinable). list: solo públicos.
      allow get: if request.auth != null;
      allow list: if (request.auth != null && resource.data.visibility == 'public' && request.query.limit <= 50) || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && validEvent(request.resource.data)
        && (request.resource.data.visibility == 'private' || request.resource.data.publicAck.acceptedAt == request.time)
        && existsAfter(participantPath(eid, request.auth.uid));
      allow update: if isEventOrganizer(eid)
        && request.resource.data.organizerUid == resource.data.organizerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validEvent(request.resource.data);
      allow delete: if false;

      match /participants/{pid} {
        allow read: if isEventOrganizer(eid) || isEventParticipant(eid);
        allow create: if request.auth != null
          && request.resource.data.uid == pid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'rocketId', 'photoURL', 'role', 'status',
              'emergencyComplete', 'invitedBy', 'consent', 'updatedAt'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
          && request.resource.data.emergencyComplete is bool
          && (
            // 1) El organizador se agrega a sí mismo al crear el evento
            (pid == request.auth.uid && request.resource.data.role == 'organizer'
              && request.resource.data.status == 'confirmed'
              && getAfter(eventPath(eid)).data.organizerUid == request.auth.uid)
            // 2) El organizador invita a alguien con perfil público
            || (pid != request.auth.uid && request.resource.data.role == 'participant'
              && request.resource.data.status == 'invited'
              && request.resource.data.invitedBy == request.auth.uid
              && isEventOrganizer(eid)
              && exists(/databases/$(database)/documents/publicProfiles/$(pid)))
            // 3) Una persona se une (evento público o con enlace), con consentimiento
            || (pid == request.auth.uid && request.resource.data.role == 'participant'
              && request.resource.data.status == 'confirmed'
              && request.resource.data.consent.acceptedAt == request.time
              && get(eventPath(eid)).data.status == 'published')
          );
        // Solo la propia persona cambia su estado (confirmar con consentimiento / rechazar)…
        allow update: if request.auth != null && pid == request.auth.uid
          && (
            (resource.data.role == 'participant'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'emergencyComplete', 'consent', 'updatedAt'])
              && request.resource.data.status in ['confirmed', 'declined']
              && request.resource.data.emergencyComplete is bool
              && (request.resource.data.status == 'declined' || request.resource.data.consent.acceptedAt == request.time))
            // …el organizador comparte su propia ficha (con consentimiento, sin cambiar su rol ni estado)…
            || (resource.data.role == 'organizer'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergencyComplete', 'consent', 'updatedAt'])
              && request.resource.data.emergencyComplete is bool
              && request.resource.data.consent.acceptedAt == request.time)
            // …o, ya confirmada, mantiene al día el indicador de ficha completa (sin tocar estado ni consentimiento)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergencyComplete', 'updatedAt'])
              && resource.data.status == 'confirmed'
              && request.resource.data.emergencyComplete is bool)
          );
        // Salir (la propia persona) o quitar (el organizador); el organizador no se quita a sí mismo
        allow delete: if request.auth != null && resource.data.role == 'participant'
          && (pid == request.auth.uid || isEventOrganizer(eid));
      }

      // Copia de la ficha de emergencia que el participante comparte al confirmar.
      // Solo se lee tras registrar la visualización (con notificación) hace < 15 min y hasta 2 días después del evento:
      //  · el equipo de seguridad (organizador + co-organizadores confirmados), o
      //  · cualquier confirmado con "acceso de emergencia", solo dentro de la ventana del evento.
      match /sensitive/{pid} {
        allow create, update: if request.auth != null && pid == request.auth.uid
          && getAfter(participantPath(eid, pid)).data.status == 'confirmed'
          // el organizador solo comparte su ficha si dio su consentimiento
          && (getAfter(participantPath(eid, pid)).data.role == 'participant' || 'consent' in getAfter(participantPath(eid, pid)).data)
          && request.resource.data.keys().hasOnly(['fullName', 'docType', 'docNumber', 'birthDate', 'phone',
              'emergencyName', 'emergencyRelationship', 'emergencyPhone', 'insuranceSystem', 'insuranceDetail',
              'bloodType', 'allergies', 'conditions', 'medications', 'updatedAt']);
        allow delete: if request.auth != null && (pid == request.auth.uid || isEventOrganizer(eid));
        allow read: if request.auth != null
          && request.time < get(eventPath(eid)).data.endAt + duration.value(2, 'd')
          && get(/databases/$(database)/documents/events/$(eid)/viewLog/$(pid)).data.viewerUid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eid)/viewLog/$(pid)).data.lastViewedAt > request.time - duration.value(15, 'm')
          && (isEventLead(eid)
            || (get(/databases/$(database)/documents/events/$(eid)/viewLog/$(pid)).data.get('emergency', false) == true
              && isConfirmedParticipant(eid)
              && inEmergencyWindow(eid)));
      }

      // Registro de visualizaciones de fichas: exige crear la notificación al participante en el mismo lote
      match /viewLog/{pid} {
        allow read: if isEventLead(eid) || (request.auth != null && pid == request.auth.uid);
        allow create, update: if request.auth != null
          && exists(participantPath(eid, pid))
          && request.resource.data.keys().hasOnly(['viewerUid', 'lastViewedAt', 'notifId', 'emergency'])
          && request.resource.data.viewerUid == request.auth.uid
          && request.resource.data.lastViewedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(pid)/notifications/$(request.resource.data.notifId)).data.eventId == eid
          && getAfter(/databases/$(database)/documents/users/$(pid)/notifications/$(request.resource.data.notifId)).data.actorUid == request.auth.uid
          && (
            // Equipo de seguridad: "vio tu ficha" o "guardó tu ficha para usarla sin señal"
            (isEventLead(eid)
              && request.resource.data.get('emergency', false) == false
              && getAfter(/databases/$(database)/documents/users/$(pid)/notifications/$(request.resource.data.notifId)).data.type in ['sensitive_view', 'sensitive_saved'])
            // Acceso de emergencia de un confirmado (nunca sobre su propia ficha), dentro de la ventana
            || (pid != request.auth.uid
              && request.resource.data.emergency == true
              && isConfirmedParticipant(eid)
              && inEmergencyWindow(eid)
              && getAfter(/databases/$(database)/documents/users/$(pid)/notifications/$(request.resource.data.notifId)).data.type == 'emergency_access')
          );
        allow delete: if false;
      }
    }

    // ---------- Formadores (ver iadocs/formadores.md) ----------
    // providers/{pid}: organización (id automático) o independiente (id ind_{uid}, uno por persona).
    // Se registran en estado pending y solo la administración los aprueba, rechaza o suspende.
    function providerPath(pid) {
      return /databases/$(database)/documents/providers/$(pid);
    }
    function memberPath(pid, uid) {
      return /databases/$(database)/documents/providers/$(pid)/members/$(uid);
    }
    function isProviderMember(pid) {
      return request.auth != null && exists(memberPath(pid, request.auth.uid));
    }
    // Responsable (owner) del formador: administra el equipo
    function isProviderOwner(pid) {
      return request.auth != null
        && exists(memberPath(pid, request.auth.uid))
        && get(memberPath(pid, request.auth.uid)).data.role == 'owner';
    }
    function invitePath(pid, uid) {
      return /databases/$(database)/documents/providers/$(pid)/invites/$(uid);
    }
    function validCredential(c) {
      return c is map
        && c.keys().hasOnly(['name', 'issuer', 'number', 'expiresAt', 'evidenceUrl'])
        && c.name is string && c.name.size() >= 2 && c.name.size() <= 100
        && c.issuer is string && c.issuer.size() >= 2 && c.issuer.size() <= 100
        && optStr(c, 'number', 60)
        && optStr(c, 'evidenceUrl', 300)
        && (!('expiresAt' in c) || c.expiresAt == '' || (c.expiresAt is string && c.expiresAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')));
    }
    function validProvider(pid, d) {
      return d.keys().hasOnly(['kind', 'name', 'website', 'about', 'legalName', 'rut', 'credential', 'contact', 'ownerUid',
          'status', 'reviewNote', 'reviewedAt', 'reviewedBy', 'createdAt', 'updatedAt'])
        && d.kind in ['organization', 'independent']
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && optStr(d, 'website', 200)
        && optStr(d, 'about', 500)
        && optStr(d, 'reviewNote', 500)
        && d.status in ['pending', 'approved', 'rejected', 'suspended']
        && d.ownerUid is string
        && d.contact is map && d.contact.keys().hasOnly(['name', 'email', 'phone'])
        && d.contact.name is string && d.contact.name.size() <= 100
        && d.contact.email is string && d.contact.email.size() <= 200
        && optStr(d.contact, 'phone', 30)
        && (d.kind == 'organization'
          ? (!pid.matches('^ind_.*')
              && d.legalName is string && d.legalName.size() >= 2 && d.legalName.size() <= 120
              && d.rut is string && d.rut.matches('^[0-9]{7,8}-[0-9K]$')
              && !('credential' in d))
          : (pid == 'ind_' + d.ownerUid
              && validCredential(d.credential)
              && !('legalName' in d) && !('rut' in d)));
    }
    // Campos que la persona puede editar mientras su solicitud está en revisión o fue rechazada
    function providerEditableKeys() {
      return ['name', 'website', 'about', 'legalName', 'rut', 'credential', 'contact', 'status', 'updatedAt'];
    }

    match /providers/{pid} {
      allow get: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || isProviderMember(pid)
        || (request.auth != null && resource.data.status == 'approved');
      // Catálogo de formadores aprobados (consulta con where status == 'approved')
      allow list: if isAdmin() || (request.auth != null && resource.data.status == 'approved');

      // Registro: solicitud en revisión + su membresía de responsable, en el mismo lote
      allow create: if request.auth != null
        && validProvider(pid, request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('reviewNote' in request.resource.data)
        && !('reviewedAt' in request.resource.data)
        && !('reviewedBy' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.contact.email == request.auth.token.email
        && existsAfter(memberPath(pid, request.auth.uid))
        && getAfter(memberPath(pid, request.auth.uid)).data.role == 'owner';
      // Administración: "Hacer formador" a un deportista (puede quedar aprobado de inmediato)
      allow create: if isAdmin()
        && validProvider(pid, request.resource.data)
        && existsAfter(memberPath(pid, request.resource.data.ownerUid));

      // La persona corrige su solicitud y la reenvía (siempre vuelve a revisión)
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status in ['pending', 'rejected']
        && validProvider(pid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(providerEditableKeys())
        && request.resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.contact.email == request.auth.token.email;
      // Administración: solo el estado y la revisión; nunca los datos del formador
      allow update: if isAdmin()
        && validProvider(pid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt', 'reviewedBy', 'updatedAt']);

      // Retirar la solicitud (no aprobada) junto con su membresía; la administración puede borrar cualquiera
      allow delete: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status in ['pending', 'rejected']
          && !existsAfter(memberPath(pid, request.auth.uid)));

      // Membresías: providers/{pid}/members/{uid}
      match /members/{uid} {
        allow get: if isOwner(uid) || isAdmin() || isProviderMember(pid);
        allow list: if isAdmin() || isProviderMember(pid);
        // Al registrarse: la persona queda como responsable de la solicitud que crea en el mismo lote
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'addedBy', 'since'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'owner'
          && request.resource.data.addedBy == uid
          && request.resource.data.since == request.time
          && !exists(providerPath(pid))
          && existsAfter(providerPath(pid))
          && getAfter(providerPath(pid)).data.ownerUid == uid;
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['uid', 'role', 'addedBy', 'since'])
          && request.resource.data.uid == uid
          && request.resource.data.role in ['owner', 'manager', 'instructor']
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.since == request.time;
        // Aceptar una invitación: la propia persona crea su membresía con el rol invitado y borra la invitación
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['uid', 'role', 'addedBy', 'since'])
          && request.resource.data.uid == uid
          && exists(invitePath(pid, uid))
          && request.resource.data.role == get(invitePath(pid, uid)).data.role
          && request.resource.data.addedBy == get(invitePath(pid, uid)).data.invitedBy
          && request.resource.data.since == request.time
          && !existsAfter(invitePath(pid, uid))
          && get(providerPath(pid)).data.status == 'approved';
        // El responsable cambia el rol de otra persona del equipo
        allow update: if isProviderOwner(pid)
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['owner', 'manager', 'instructor'];
        // Retiro de la solicitud, la administración, el responsable quitando a otra persona,
        // o alguien que sale del equipo (un responsable no puede salir: primero debe nombrar a otro)
        allow delete: if isAdmin()
          || (isOwner(uid) && !existsAfter(providerPath(pid)))
          || (isProviderOwner(pid) && uid != request.auth.uid)
          || (isOwner(uid) && resource.data.role != 'owner');
      }

      // Invitaciones: providers/{pid}/invites/{uid} (solo organizaciones aprobadas)
      match /invites/{uid} {
        allow get: if isOwner(uid) || isAdmin() || isProviderOwner(pid);
        allow list: if isAdmin() || isProviderOwner(pid);
        allow create: if (isProviderOwner(pid) || isAdmin())
          && get(providerPath(pid)).data.status == 'approved'
          && get(providerPath(pid)).data.kind == 'organization'
          && request.resource.data.keys().hasOnly(['uid', 'role', 'providerName', 'invitedBy', 'invitedByName', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.role in ['owner', 'manager', 'instructor']
          && request.resource.data.providerName == get(providerPath(pid)).data.name
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.invitedByName is string && request.resource.data.invitedByName.size() <= 120
          && request.resource.data.createdAt == request.time
          && !exists(memberPath(pid, uid));
        // Rechazar (la persona), cancelar (el responsable o la administración) o al aceptar
        allow delete: if isOwner(uid) || isProviderOwner(pid) || isAdmin();
      }
    }

    // "¿Qué invitaciones tengo?": consulta de grupo por uid (solo las propias)
    match /{path=**}/invites/{iid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // "¿De qué formadores soy parte?": consulta de grupo por uid (solo las propias membresías)
    match /{path=**}/members/{mid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if isAdmin();
    }

    // ---------- Cursos de formadores: courses/{cid} ----------
    // Los crean y editan responsables o coordinación de un formador aprobado.
    // El catálogo (status == 'published') lo lee cualquier persona con sesión.
    function canManageCourses(pid) {
      return request.auth != null
        && pid is string
        && exists(memberPath(pid, request.auth.uid))
        && get(memberPath(pid, request.auth.uid)).data.role in ['owner', 'manager']
        && get(providerPath(pid)).data.status == 'approved';
    }
    function validCourse(d) {
      return d.keys().hasOnly(['providerId', 'providerName', 'providerKind', 'title', 'category', 'summary', 'description',
          'location', 'modality', 'startDate', 'endDate', 'duration', 'priceCLP', 'spots', 'level', 'requirements',
          'certification', 'status', 'instructorUids', 'createdBy', 'createdAt', 'updatedAt'])
        && d.providerId is string
        && d.providerName is string && d.providerName.size() <= 80
        && d.providerKind in ['organization', 'independent']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 100
        && d.category in ['first_aid', 'rescue', 'navigation', 'technical', 'guiding', 'ethics']
        && d.summary is string && d.summary.size() <= 160
        && d.description is string && d.description.size() <= 2000
        && d.location is string && d.location.size() <= 150
        && d.modality in ['presencial', 'online', 'mixto']
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate >= d.startDate
        && d.duration is string && d.duration.size() <= 60
        && d.priceCLP is int && d.priceCLP >= 0 && d.priceCLP <= 10000000
        && d.spots is int && d.spots >= 1 && d.spots <= 500
        && d.level in ['Inicial', 'Intermedio', 'Avanzado']
        && d.requirements is list && d.requirements.size() <= 10
        && d.certification is string && d.certification.size() <= 120
        && d.status in ['draft', 'published', 'closed']
        && d.instructorUids is list && d.instructorUids.size() <= 20
        && d.createdBy is string;
    }

    match /courses/{cid} {
      allow get: if (request.auth != null && resource.data.status == 'published')
        || isAdmin()
        || isProviderMember(resource.data.providerId)
        // Quien postuló sigue viendo el curso aunque se cierre
        || (request.auth != null && exists(applicationPath(request.auth.uid + '_' + cid)));
      // Catálogo: consulta con where status == 'published'. El formador: where providerId == su formador.
      allow list: if (request.auth != null && resource.data.status == 'published')
        || isAdmin()
        || isProviderMember(resource.data.providerId);
      allow create: if canManageCourses(request.resource.data.providerId)
        && validCourse(request.resource.data)
        // Nombre y tipo copiados del formador (no se pueden inventar)
        && request.resource.data.providerName == get(providerPath(request.resource.data.providerId)).data.name
        && request.resource.data.providerKind == get(providerPath(request.resource.data.providerId)).data.kind
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageCourses(resource.data.providerId)
        && validCourse(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'category', 'summary', 'description', 'location', 'modality', 'startDate', 'endDate', 'duration',
          'priceCLP', 'spots', 'level', 'requirements', 'certification', 'status', 'instructorUids', 'providerName', 'updatedAt'])
        && request.resource.data.providerName == get(providerPath(resource.data.providerId)).data.name
        && request.resource.data.updatedAt == request.time;
      // Solo borradores: un curso publicado puede tener postulaciones, así que se cierra en vez de borrarse
      allow delete: if canManageCourses(resource.data.providerId) && resource.data.status == 'draft';
    }

    // Postulaciones a cursos: applications/{uid}_{courseId}
    // La persona crea (una sola vez por curso) y lee las suyas. No puede editarlas ni borrarlas.
    // Cursos reales: la postulación lleva el providerId del curso publicado; el formador la ve y
    // cambia su estado (sent → seen → accepted/rejected). Cursos de demostración (demo-*): sin formador.
    function coursePath(cid) {
      return /databases/$(database)/documents/courses/$(cid);
    }
    function applicationPath(aid) {
      return /databases/$(database)/documents/applications/$(aid);
    }
    // Responsables y coordinación del formador (los instructores, cuando existan equipos)
    function canSeeApplications(pid) {
      return request.auth != null
        && pid is string
        && exists(memberPath(pid, request.auth.uid))
        && get(memberPath(pid, request.auth.uid)).data.role in ['owner', 'manager'];
    }
    function canManageApplications(pid) {
      return canSeeApplications(pid) && get(providerPath(pid)).data.status == 'approved';
    }
    // Instructor asignado al curso (y todavía en el equipo del formador)
    function isCourseInstructor(cid) {
      return request.auth != null
        && cid is string
        && exists(coursePath(cid))
        && request.auth.uid in get(coursePath(cid)).data.get('instructorUids', [])
        && exists(memberPath(get(coursePath(cid)).data.providerId, request.auth.uid));
    }
    // Puede decidir sobre una postulación: responsable/coordinación, o el instructor asignado al curso
    function canDecideApplication(a) {
      return canManageApplications(a.providerId)
        || (isCourseInstructor(a.courseId) && get(providerPath(a.providerId)).data.status == 'approved');
    }
    function applicationCourseOk(d) {
      return ('providerId' in d)
        ? (exists(coursePath(d.courseId))
            && get(coursePath(d.courseId)).data.status == 'published'
            && get(coursePath(d.courseId)).data.providerId == d.providerId
            && get(coursePath(d.courseId)).data.title == d.courseTitle
            && get(coursePath(d.courseId)).data.providerName == d.providerName
            && get(providerPath(d.providerId)).data.status == 'approved')
        : d.courseId.matches('^demo-.*');
    }

    match /applications/{appId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Formador: consulta con where providerId == su formador
      allow read: if canSeeApplications(resource.data.providerId) || isCourseInstructor(resource.data.courseId);
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && appId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(
          ['uid', 'courseId', 'courseTitle', 'providerId', 'providerName', 'status', 'createdAt', 'consent', 'applicant'])
        && request.resource.data.status == 'sent'
        && request.resource.data.createdAt == request.time
        && request.resource.data.consent.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.consent.acceptedAt == request.time
        && request.resource.data.courseId is string && request.resource.data.courseId.size() <= 100
        && request.resource.data.applicant is map
        && request.resource.data.applicant.certifications is list
        && request.resource.data.applicant.certifications.size() <= 20
        && applicationCourseOk(request.resource.data);
      // Formador: solo el estado y un mensaje para la persona; nunca sus datos
      allow update: if canDecideApplication(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'providerNote', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['seen', 'accepted', 'rejected']
        && (!('providerNote' in request.resource.data)
          || (request.resource.data.providerNote is string && request.resource.data.providerNote.size() <= 500))
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // ---------- Verificación de certificaciones (ver iadocs/formadores.md, 3.7) ----------
    // verificationRequests/{uid}_{certId}: la persona pide a un formador aprobado que verifique una certificación.
    // Cualquier miembro del formador decide (decisión 5). Al aprobar, escribe la verificación en
    // users/{uid}/private/verifications (la que usan las insignias) en el mismo lote.
    function verificationRequestPath(rid) {
      return /databases/$(database)/documents/verificationRequests/$(rid);
    }
    function canVerify(pid) {
      return request.auth != null
        && pid is string
        && exists(memberPath(pid, request.auth.uid))
        && get(providerPath(pid)).data.status == 'approved';
    }
    function validVerificationRequest(rid, d) {
      return d.keys().hasOnly(['uid', 'certId', 'providerId', 'providerName', 'category', 'snapshot', 'applicant', 'status', 'consent', 'createdAt'])
        && d.uid == request.auth.uid
        && d.certId is string && d.certId.size() > 0 && d.certId.size() <= 60
        && rid == request.auth.uid + '_' + d.certId
        && d.status == 'pending'
        && d.providerId is string
        && get(providerPath(d.providerId)).data.status == 'approved'
        && d.providerName == get(providerPath(d.providerId)).data.name
        && d.category is string && d.category.size() <= 30
        && d.snapshot is map && d.snapshot.keys().hasOnly(['name', 'issuer', 'year', 'expiresAt'])
        && d.snapshot.name is string && d.snapshot.name.size() > 0 && d.snapshot.name.size() <= 120
        && d.snapshot.issuer is string && d.snapshot.issuer.size() <= 120
        && d.snapshot.year is string && d.snapshot.year.size() <= 4
        && d.snapshot.expiresAt is string && d.snapshot.expiresAt.size() <= 7
        && d.applicant is map && d.applicant.keys().hasOnly(['fullName', 'rocketId', 'docType', 'docNumber'])
        && d.applicant.fullName is string && d.applicant.fullName.size() <= 120
        && optStr(d.applicant, 'rocketId', 10)
        && optStr(d.applicant, 'docType', 20)
        && optStr(d.applicant, 'docNumber', 30)
        && d.consent is map && d.consent.keys().hasOnly(['version', 'acceptedAt'])
        && d.consent.acceptedAt == request.time
        && d.createdAt == request.time;
    }
    // Escritura de la verificación por el formador (users/{uid}/private/verifications)
    function providerVerifies(uid) {
      let cid = request.resource.data.get('lastCertId', '');
      let req = getAfter(verificationRequestPath(uid + '_' + cid)).data;
      let before = resource == null ? {} : resource.data.get('certs', {});
      let entry = request.resource.data.certs[cid];
      return request.auth != null
        && cid is string && cid.size() > 0
        && (resource == null
          ? request.resource.data.keys().hasOnly(['certs', 'lastCertId'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['certs', 'lastCertId']))
        && request.resource.data.certs.diff(before).affectedKeys().hasOnly([cid])
        && req.uid == uid
        && req.status == 'approved'
        && req.reviewedBy == request.auth.uid
        && canVerify(req.providerId)
        && entry.keys().hasOnly(['verifiedBy', 'providerId', 'verifiedAt', 'snapshot'])
        && entry.verifiedBy == req.providerName
        && entry.providerId == req.providerId
        && entry.snapshot == req.snapshot
        && entry.verifiedAt == request.time;
    }

    match /verificationRequests/{rid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Formador: consulta con where providerId == su formador
      allow read: if isProviderMember(resource.data.providerId);
      allow list: if isAdmin();
      allow create: if request.auth != null && validVerificationRequest(rid, request.resource.data);
      // Pedirla de nuevo: a otro formador, con datos corregidos o tras un rechazo
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validVerificationRequest(rid, request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Formador: verifica o rechaza una solicitud pendiente
      allow update: if canVerify(resource.data.providerId)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && optStr(request.resource.data, 'note', 500)
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    // Todo lo demás denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
