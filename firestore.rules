rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Campo opcional: si viene, debe ser string con largo máximo
    function optStr(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function rocketIdPath(code) {
      return /databases/$(database)/documents/rocketIds/$(code);
    }

    // rocketId en el perfil: una vez asignado no cambia; para asignarlo, su reserva
    // en rocketIds/{código} debe quedar a nombre de la persona en el mismo lote.
    function rocketIdOk(uid) {
      let had = resource != null && ('rocketId' in resource.data);
      let next = request.resource.data.get('rocketId', null);
      return had
        ? next == resource.data.rocketId
        : (next == null
            || (next is string
                && next.matches('^[BCDFGHJKLMNPQRSTVWXYZ][AEIOU]-[0-9]{4}$')
                && existsAfter(rocketIdPath(next))
                && getAfter(rocketIdPath(next)).data.uid == uid));
    }

    // Perfil e identificación: users/{uid}
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt', 'updatedAt',
          'fullName', 'docType', 'docNumber', 'birthDate', 'phone', 'contactEmail',
          'rocketId', 'discoverable',
          'bio' // legado del primer MVP
        ])
        && rocketIdOk(uid)
        && optStr(request.resource.data, 'fullName', 120)
        && optStr(request.resource.data, 'docType', 20)
        && optStr(request.resource.data, 'docNumber', 30)
        // Si es RUT, debe venir formateado: 12.345.678-5 / 7.775.735-K
        && (request.resource.data.get('docType', '') != 'rut'
            || request.resource.data.get('docNumber', '') == ''
            || request.resource.data.docNumber.matches('^[0-9]{1,2}[.][0-9]{3}[.][0-9]{3}-[0-9K]$'))
        && optStr(request.resource.data, 'birthDate', 10)
        && optStr(request.resource.data, 'phone', 20)
        && optStr(request.resource.data, 'contactEmail', 120)
        && (!('discoverable' in request.resource.data) || request.resource.data.discoverable is bool);
      allow delete: if false;

      // Mi cordada: lista privada de contactos. Solo se puede agregar a personas con perfil público.
      match /contacts/{cid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && cid != uid
          && request.resource.data.keys().hasOnly(['uid', 'rocketId', 'displayName', 'photoURL', 'addedAt'])
          && request.resource.data.uid == cid
          && exists(/databases/$(database)/documents/publicProfiles/$(cid))
          && optStr(request.resource.data, 'displayName', 120)
          && optStr(request.resource.data, 'rocketId', 7);
      }

      // Conocimientos y certificaciones outdoor: users/{uid}/private/skills
      match /private/skills {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['hasCertifications', 'categories', 'certifications', 'updatedAt'])
          && request.resource.data.hasCertifications in ['yes', 'no', '']
          && request.resource.data.categories is list
          && request.resource.data.categories.size() <= 10
          && request.resource.data.certifications is list
          && request.resource.data.certifications.size() <= 20;
        allow delete: if false;
      }

      // Verificaciones de certificaciones hechas por instituciones.
      // La persona solo puede leerlas; nadie puede escribirlas desde el cliente.
      // TODO: permitir escritura a instituciones (custom claim) cuando exista su app.
      match /private/verifications {
        // Legible por cualquier persona autenticada: las insignias de los perfiles públicos se
        // calculan con estas verificaciones (no con lo que declara cada persona).
        allow get: if request.auth != null;
        allow write: if false;
      }

      // Ficha de emergencia (datos sensibles de salud): users/{uid}/private/emergency
      match /private/{docId} {
        allow read: if isOwner(uid) && docId == 'emergency';
        allow create, update: if isOwner(uid) && docId == 'emergency'
          && request.resource.data.keys().hasOnly([
            'emergencyName', 'emergencyRelationship', 'emergencyPhone',
            'insuranceSystem', 'insuranceDetail', 'bloodType',
            'allergies', 'conditions', 'medications', 'updatedAt'
          ])
          && optStr(request.resource.data, 'emergencyName', 120)
          && optStr(request.resource.data, 'emergencyRelationship', 60)
          && optStr(request.resource.data, 'emergencyPhone', 20)
          && optStr(request.resource.data, 'insuranceSystem', 20)
          && optStr(request.resource.data, 'insuranceDetail', 500)
          && optStr(request.resource.data, 'bloodType', 10)
          && optStr(request.resource.data, 'allergies', 1000)
          && optStr(request.resource.data, 'conditions', 1000)
          && optStr(request.resource.data, 'medications', 1000);
        allow delete: if false;
      }
    }

    // Reserva de rocketIds: garantiza que cada código sea único.
    // Solo se puede crear (si ya existe, el set cuenta como update y se rechaza → colisión),
    // una vez por persona, y nunca modificar ni borrar.
    match /rocketIds/{code} {
      // get (no list): buscar a alguien por su rocketId exacto
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[BCDFGHJKLMNPQRSTVWXYZ][AEIOU]-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        // la persona aún no tenía rocketId…
        && !(exists(userPath(request.auth.uid)) && ('rocketId' in get(userPath(request.auth.uid)).data))
        // …y en el mismo lote lo escribe en su perfil
        && getAfter(userPath(request.auth.uid)).data.get('rocketId', '') == code;
      allow update, delete: if false;
    }

    // Perfil público: nombre, avatar, rocketId y conocimientos. Se puede leer uno a uno (get), nunca listar.
    match /publicProfiles/{uid} {
      allow get: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'rocketId', 'displayName', 'photoURL', 'skills', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.rocketId == get(userPath(uid)).data.get('rocketId', '')
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && request.resource.data.skills is map
        && request.resource.data.skills.categories is list && request.resource.data.skills.categories.size() <= 10
        && request.resource.data.skills.certifications is list && request.resource.data.skills.certifications.size() <= 20;
      allow delete: if isOwner(uid);
    }

    // Índice de búsqueda por correo: emailIndex/{sha256(correo en minúsculas)} → { uid }.
    // El correo nunca se guarda en texto; solo encuentra a alguien quien conoce el correo exacto.
    // Solo puedes indexar TU correo verificado (el hash se recalcula aquí).
    match /emailIndex/{hash} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && hash == hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Postulaciones a cursos: applications/{uid}_{courseId}
    // La persona crea (una sola vez por curso) y lee las suyas. No puede editarlas ni borrarlas:
    // el estado (sent → seen → accepted/rejected) lo cambiará la institución desde su app.
    match /applications/{appId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && appId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.keys().hasOnly(
          ['uid', 'courseId', 'courseTitle', 'providerName', 'status', 'createdAt', 'consent', 'applicant'])
        && request.resource.data.status == 'sent'
        && request.resource.data.createdAt == request.time
        && request.resource.data.consent.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.consent.acceptedAt == request.time
        && request.resource.data.courseId is string && request.resource.data.courseId.size() <= 100
        && request.resource.data.applicant is map
        && request.resource.data.applicant.certifications is list
        && request.resource.data.applicant.certifications.size() <= 20;
      allow update, delete: if false;
    }

    // Todo lo demás denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
